source "https://rubygems.org"

# Pinned to the versions GitHub Pages builds the site with
# (https://pages.github.com/versions/). The `github-pages` gem itself isn't
# used because it doesn't install on Ruby 4.
gem "jekyll", "3.10.0"
gem "liquid", "4.0.4"
gem "kramdown", "2.4.0"
gem "kramdown-parser-gfm", "1.1.0"
gem "rouge", "3.30.0"

group :jekyll_plugins do
  gem "jekyll-feed", "0.17.0"
end

# Standard-library gems Jekyll 3 expects that newer Rubies no longer bundle.
gem "base64"
gem "bigdecimal"
gem "csv"
gem "logger"
gem "ostruct"
gem "webrick"
